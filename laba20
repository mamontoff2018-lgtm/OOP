// =========================================================================
// ФАЙЛ 3: SettingsViewModel.cs (Класс с данными)
// =========================================================================
using System.ComponentModel;
using System.Windows.Media;

namespace laba20
{
    public class SettingsViewModel : INotifyPropertyChanged
    {
        private string _windowTitle = "Лаба 20: Привязка данных";
        private string _textContent = "Привет, WPF!";
        private int _fontSize = 24;
        private Brush _textColor = Brushes.Black;
        private bool _isTextVisible = true;
        private string _fontFamily = "Arial";

        public string WindowTitle
        {
            get { return _windowTitle; }
            set { _windowTitle = value; OnPropertyChanged(nameof(WindowTitle)); }
        }

        public string TextContent
        {
            get { return _textContent; }
            set { _textContent = value; OnPropertyChanged(nameof(TextContent)); }
        }

        public int FontSize
        {
            get { return _fontSize; }
            set { _fontSize = value; OnPropertyChanged(nameof(FontSize)); }
        }

        public Brush TextColor
        {
            get { return _textColor; }
            set { _textColor = value; OnPropertyChanged(nameof(TextColor)); }
        }

        public bool IsTextVisible
        {
            get { return _isTextVisible; }
            set { _isTextVisible = value; OnPropertyChanged(nameof(IsTextVisible)); }
        }

        public string FontFamily
        {
            get { return _fontFamily; }
            set { _fontFamily = value; OnPropertyChanged(nameof(FontFamily)); }
        }

        public event PropertyChangedEventHandler PropertyChanged;
        protected void OnPropertyChanged(string propertyName)
        {
            PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(propertyName));
        }
    }
}

// =========================================================================
// ФАЙЛ 4: MainWindow.xaml (Интерфейс)
// =========================================================================
<Window x:Class="laba20.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle, Mode=TwoWay}" 
        Height="450" Width="700"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            
            <Label Content="Заголовок окна (TwoWay):" FontWeight="Bold"/>
            <TextBox Text="{Binding WindowTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <Label Content="Текст (TwoWay):" FontWeight="Bold"/>
            <TextBox Text="{Binding TextContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <Label Content="Размер шрифта (TwoWay):" FontWeight="Bold"/>
            <Slider Minimum="10" Maximum="72" Value="{Binding FontSize, Mode=TwoWay}" TickFrequency="2" IsSnapToTickEnabled="True" Margin="0,0,0,10"/>

            <Label Content="Семейство шрифтов (TwoWay):" FontWeight="Bold"/>
            <ComboBox SelectedItem="{Binding FontFamily, Mode=TwoWay}" Margin="0,0,0,10">
                <ComboBoxItem Content="Arial"/>
                <ComboBoxItem Content="Times New Roman"/>
                <ComboBoxItem Content="Verdana"/>
                <ComboBoxItem Content="Consolas"/>
            </ComboBox>

            <CheckBox Content="Показывать текст (TwoWay)" IsChecked="{Binding IsTextVisible, Mode=TwoWay}" Margin="0,0,0,10"/>

            <Label Content="Цвет текста (TwoWay):" FontWeight="Bold"/>
            <ListBox SelectedValue="{Binding TextColor, Mode=TwoWay}" SelectedValuePath="Tag" Height="100">
                <ListBoxItem Content="Черный" Tag="{x:Static Brushes.Black}"/>
                <ListBoxItem Content="Красный" Tag="{x:Static Brushes.Red}"/>
                <ListBoxItem Content="Синий" Tag="{x:Static Brushes.Blue}"/>
                <ListBoxItem Content="Зеленый" Tag="{x:Static Brushes.Green}"/>
            </ListBox>
        </StackPanel>

        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="2" Margin="10" Background="#F0F0F0">
            <TextBlock x:Name="lblPreview"
                       Text="{Binding TextContent, Mode=OneWay}" 
                       FontSize="{Binding FontSize, Mode=OneWay}"
                       FontFamily="{Binding FontFamily, Mode=OneWay}"
                       Foreground="{Binding TextColor, Mode=OneWay}"
                       Visibility="{Binding IsTextVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>

// =========================================================================
// ФАЙЛ 5: MainWindow.xaml.cs (Динамическая привязка)
// =========================================================================
using System.Windows;
using System.Windows.Controls;
using System.Windows.Data;

namespace laba20
{
    public partial class MainWindow : Window
    {
        public MainWindow()
        {
            InitializeComponent();
            
            SettingsViewModel viewModel = new SettingsViewModel();
            this.DataContext = viewModel;

            Binding dynamicBinding = new Binding("WindowTitle")
            {
                Source = viewModel,
                Mode = BindingMode.OneWay
            };
            lblPreview.SetBinding(TextBlock.ToolTipProperty, dynamicBinding);
        }
    }
}
