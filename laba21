using System;
using System.Collections.Generic;
using System.Globalization;
using System.IO;

namespace DataTier
{
    public class ВсеАвтомобили
    {
        public static List<Автомобиль> ЗагрузитьИзФайла(string путьКФайлу)
        {
            List<Автомобиль> список = new List<Автомобиль>();
            string[] строки = File.ReadAllLines(путьКФайлу);
            
            foreach (string строка in строки)
            {
                if (string.IsNullOrWhiteSpace(строка)) continue;

                string[] части = строка.Split(';');
                if (части.Length == 4)
                {
                    string стоимость = части[2].Trim().Replace('.', ',');
                    
                    список.Add(new Автомобиль
                    {
                        Модель = части[0].Trim(),
                        Производитель = части[1].Trim(),
                        Стоимость = Convert.ToDouble(стоимость, CultureInfo.CurrentCulture),
                        Пробег = Convert.ToInt32(части[3].Trim())
                    });
                }
            }
            return список;
        }
    }
}

