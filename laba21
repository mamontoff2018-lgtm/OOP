<Window x:Class="PresentationTier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автосалон (Вариант 13)" Height="500" Width="950"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Загрузить данные из файла" Click="btnLoad_Click" Padding="10,5" FontWeight="Bold" Background="#FF2196F3" Foreground="White"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Список автомобилей" Grid.Column="0" Margin="0,0,5,0">
                <ListBox x:Name="lstCars" ItemsSource="{Binding СписокАвто}" DisplayMemberPath="ПредставлениеАвто" Margin="5"/>
            </GroupBox>

            <GroupBox Header="Средние показатели по производителям" Grid.Column="1" Margin="5,0,0,0">
                <ListView x:Name="lstSummary" ItemsSource="{Binding Сводка}" Margin="5">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Производитель" DisplayMemberBinding="{Binding Производитель}" Width="150"/>
                            <GridViewColumn Header="Ср. пробег" DisplayMemberBinding="{Binding СреднийПробег, StringFormat={}{0:N0}}" Width="100"/>
                            <GridViewColumn Header="Ср. стоимость" DisplayMemberBinding="{Binding СредняяСтоимость, StringFormat={}{0:C}}" Width="120"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
        </Grid>
    </Grid>
</Window>

