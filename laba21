using System.Collections.Generic;
using System.Linq;
using DataTier;

namespace LogicTier
{
    public class Автосалон
    {
        private List<АвтомобильнаяПозиция> _авто = new List<АвтомобильнаяПозиция>();

        public Автосалон(string путьКФайлу)
        {
            List<Автомобиль> сырыеДанные = ВсеАвтомобили.ЗагрузитьИзФайла(путьКФайлу);
            foreach (var a in сырыеДанные)
            {
                _авто.Add(new АвтомобильнаяПозиция(a));
            }
        }

        public List<АвтомобильнаяПозиция> СписокАвто { get { return _авто; } }
        
        public List<СводкаПоПроизводителю> Сводка
        {
            get
            {
                return _авто
                    .GroupBy(a => a.Производитель)
                    .Select(g => new СводкаПоПроизводителю
                    {
                        Производитель = g.Key,
                        СреднийПробег = g.Average(a => a.Пробег),
                        СредняяСтоимость = g.Average(a => a.Стоимость)
                    })
                    .ToList();
            }
        }
    }
}

