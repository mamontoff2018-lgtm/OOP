using DataTier;

namespace LogicTier
{
    public class АвтомобильнаяПозиция
    {
        private Автомобиль _авто;

        public АвтомобильнаяПозиция(Автомобиль a)
        {
            _авто = a;
        }

        public string Модель { get { return _авто.Модель; } }
        public string Производитель { get { return _авто.Производитель; } }
        public double Стоимость { get { return _авто.Стоимость; } }
        public int Пробег { get { return _авто.Пробег; } }

        public string ПредставлениеАвто 
        { 
            get { return $"{Модель} ({Производитель}) | Цена: {Стоимость:C} | Пробег: {Пробег}"; } 
        }
    }
}

