using System;
using CylinderData;
using CylinderLogic;

namespace laba24
{
    class Program
    {
        static void Main(string[] args)
        {
            Console.WriteLine("=== Лабораторная работа 24 (Вариант 13) ===");
            Console.WriteLine("Расчет площади поверхности и объема цилиндра.\n");

            try
            {
                Console.Write("Введите радиус R: ");
                double r = Convert.ToDouble(Console.ReadLine());

                Console.Write("Введите высоту h: ");
                double h = Convert.ToDouble(Console.ReadLine());

                if (r <= 0 || h <= 0)
                {
                    Console.WriteLine("Ошибка: значения должны быть больше нуля.");
                    return;
                }

                Cylinder myCylinder = new Cylinder(r, h);

                double volume = Calculator.GetVolume(myCylinder);
                double surfaceArea = Calculator.GetSurfaceArea(myCylinder);

                Console.WriteLine($"\nОбъем цилиндра: {volume:F2}");
                Console.WriteLine($"Площадь поверхности: {surfaceArea:F2}");
            }
            catch (FormatException)
            {
                Console.WriteLine("Ошибка: введены некорректные числа (используйте запятую для дробей).");
            }
            
            Console.WriteLine("\nНажмите любую клавишу для выхода...");
            Console.ReadKey();
        }
    }
}
