namespace CylinderData
{
    public class Cylinder
    {
        public double R { get; set; }
        public double H { get; set; }

        public Cylinder(double r, double h)
        {
            R = r;
            H = h;
        }
    }
}

// =========================================================================
// ПРОЕКТ 2: CylinderLogic
// ФАЙЛ 2.1: Calculator.cs
// =========================================================================
using System;
using CylinderData;

namespace CylinderLogic
{
    public class Calculator
    {
        // Метод для расчета объема: V = π * R^2 * h
        public static double GetVolume(Cylinder c)
        {
            return Math.PI * Math.Pow(c.R, 2) * c.H;
        }

        // Метод для расчета площади поверхности: S = 2 * π * R * (R + h)
        public static double GetSurfaceArea(Cylinder c)
        {
            return 2 * Math.PI * c.R * (c.R + c.H);
        }
    }
}

