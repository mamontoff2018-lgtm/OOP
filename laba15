using System;
using System.Drawing;
using System.IO;
using System.Windows.Forms;

namespace laba15
{
    public partial class Form1 : Form
    {
        private Button btnColor, btnFont, btnFile, btnFolder;
        private Panel panelColor;
        private TextBox txtFont, txtFile, txtFolder;

        private TextBox txtX, txtN, txtResult;
        private RichTextBox rtbLog;
        private Button btnCalc, btnSave, btnLoad, btnListColor, btnResultFont;

        public Form1()
        {
            InitializeComponent();
            SetupUI();
        }

        private void SetupUI()
        {
            this.Text = "Лабораторная работа 15 (Вариант 13)";
            this.Size = new Size(950, 600);
            this.StartPosition = FormStartPosition.CenterScreen;

            // ================= ЗАДАНИЕ 1 =================
